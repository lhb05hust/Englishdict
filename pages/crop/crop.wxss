/* pages/crop/crop.wxss */

page {
  height: 100vh;
  background: #000; /* 页面黑色背景 */
}

.container {
  height: 100vh;
  width: 100vw;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 白色卡片 */
.card {
  width: 98%;
  max-width: 700rpx;
  background: #ffffff;
  border-radius: 48rpx;
  padding: 36rpx 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.5);
  margin-bottom: 60rpx;
}

.not-full-screen .card {
  margin-bottom: 0rpx;
}

/* 标题 */
.header {
  width: 100%;
  text-align: center;
  margin-bottom: 30rpx;
  position: relative;   /* 新增：旋转按钮的定位基准 */
}

.title {
  font-size: 38rpx;
  font-weight: 600;
  color: #033c81;
  position: relative; 
  display: inline-block; /* 关键：让宽度收缩到只有文字大小 */
}

/* ===== 旋转按钮（标题左右两侧） ===== */
.rotate-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1; /* 避免特殊字符基线带来的偏移 */
  border-radius: 50%;
  background: #e0f2fe;
  color: #033c81;
  font-size: 44rpx;
  padding-bottom: 8rpx
}

.rotate-btn.rotate-left  { left: 6rpx; }
.rotate-btn.rotate-right { right: 6rpx; }
/* 旋转按钮按下时的缩放效果（保留居中偏移，避免跳动） */
.rotate-btn-hover {
  transform: translateY(-50%) scale(0.9);
}

/* 问号按钮样式（与旋转按钮高度、配色一致，但更小巧） */
.help-btn {
  position: absolute;
  top: -24rpx;     /* 向上偏移32，居中在角落 */
  right: -46rpx;   /* 向右偏移32，居中在角落 */
  width: 64rpx;
  height: 64rpx;
  background: transparent;
  z-index: 10;
}

/* 视觉小球（大小依然是你要求的22rpx） */
.help-btn::after {
  content: 'i';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 22rpx;
  height: 22rpx;
  line-height: 22rpx;
  border-radius: 50%;
  background: #bfdbfe;   /* 背景颜色不变 */
  color: #222222;        /* 文字颜色不变 */
  font-size: 26rpx;      /* 保持你原来的字号不变 */
  text-align: center;
}
.help-btn-hover {
  transform: scale(0.9);
}

/* 图片容器：固定宽高，半透明灰黑背景，居中 */
.image-wrap {
  background: rgba(247, 248, 247, 0.75); /* 半透明灰黑 */
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

/* 图片等比填充 */
.image {
  width: 100%;
  height: 100%;
  display: block;
}

.crop-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.crop-box {
  position: absolute;
  border: 1px solid white; 
  box-sizing: border-box;
  background: transparent;
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.25);
}
.crop-box.breath .corner::after {
  animation: cornerBreath 1.5s ease-in-out 1;
}
@keyframes cornerBreath {
  0%, 100% {
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }
  50% {
    box-shadow: 
      0 0 24px 10px rgba(96, 165, 250, 0.95),
      0 2px 6px rgba(0, 0, 0, 0.3);
  }
}
.crop-box.breath {
  animation: boxPulse 1.5s ease-in-out 1;
}
@keyframes boxPulse {
  0%, 100% {
    border-color: rgba(255, 255, 255, 0.9);
  }
  50% {
    border-color: #bfdbfe;
  }
}
/* 四个圆角控制点 */
.corner {
  position: absolute;
  width: 88rpx;
  height: 88rpx;
  z-index: 20;
  transform: translate(-50%, -50%);
  background: transparent; /* 背景透明 */
  border: none;            /* 边框透明，消除白圈 */
  box-shadow: none;
}

/* 视觉黑球（大小随 JS 动态变化，完美居中在热区上） */
.corner::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: var(--corner-size, 44rpx);
  height: var(--corner-size, 44rpx);
  background: black;
  border: 2px solid white;
  border-radius: 50%;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  box-sizing: border-box;
}
/* 位置定位 */
.corner.lt { left: 0; top: 0; }
.corner.rt { left: 100%; top: 0; }
.corner.lb { left: 0; top: 100%; }
.corner.rb { left: 100%; top: 100%; }

/* 底部提示文字 */
.hint {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.9);
  font-size: 27rpx;
  background: rgba(0,0,0,0.4);
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  white-space: nowrap;
  font-weight: bold;
  z-index: 999;
}

/* 底部按钮区 */
.toolbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  gap: 26rpx;
}

.btn-reselect, .btn-start, .btn-exit {
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 41rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

/* 1. 重新上传（左） */
.btn-reselect {
  flex: 1.1;
  background: #e0f2fe;
  color: #333;
  font-size: 30rpx;
  padding: 0 28rpx 0 28rpx;
}

/* 2. 开始识别（正中间，主按钮最宽最大） */
.btn-start {
  flex: 1.5;   /* 比两边宽大一点 */
  background: #bfdbfe; 
  color: #222222;
  font-size: 36rpx;
  font-weight: 600;
}

/* 3. 退出（右，弱化，细窄） */
.btn-exit {
  flex: 0.4;
  background: transparent; 
  color: #999;
  font-size: 26rpx;
  padding: 0 24rpx 0 24rpx;
}
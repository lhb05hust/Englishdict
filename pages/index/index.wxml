<view class="status-bar" style="height:{{statusBarHeight}}px; background-color: #f5faff;"></view>
<!-- 自定义导航栏 -->
<view class="custom-nav" style="padding-top:{{statusBarHeight}}px;">
  <view class="nav-title">英语听写帮手</view>
</view>

<view class="page" style="padding-top:{{navTotalHeight}}px">

  <!-- 主入口：按教材听写 -->
  <view class="func-card main-card" bindtap="goBooks" hover-class="card-hover">
    <view class="main-icon">
      <text class="icon-emoji">📚</text>
      <text class="icon-badge">abc</text>
    </view>
    <view class="main-text">
      <view class="main-title">按教材听写单词</view>
      <view class="main-desc">同步英文单词表，按单元听写</view>
    </view>
    <view class="arrow-btn"><text class="arrow">></text></view>
  </view>

  <!-- 拍照听写（加宽） + 相册 / 粘贴 -->
  <view class="photo-row">
    <!-- 左侧：拍照听写 -->
    <view class="func-card photo-card" bindtap="goPhotoDict" hover-class="card-hover">
      <view class="photo-icon">📷</view>
      <view class="photo-text">
        <view class="photo-title">拍照听写</view>
        <view class="photo-desc">拍单词表，识别听写</view>
      </view>
      <view class="photo-arrow">›</view>
    </view>

    <!-- 右侧：相册 + 粘贴 上下堆叠 -->
    <view class="sub-col">
      <view class="func-card sub-card" bindtap="goUploadPhoto" hover-class="card-hover">
        <view class="sub-icon">🖼</view>
        <view class="sub-title">相册取词</view>
        <view class="sub-arrow">›</view>
      </view>
      <view class="func-card sub-card" bindtap="goCustomDict" hover-class="card-hover">
        <view class="sub-icon">✍️</view>
        <view class="sub-title">粘贴录入</view>
        <view class="sub-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 上次听：轻提示（有记录时才显示） -->
  <view wx:if="{{lastTextbookText}}" class="last-hint" bindtap="continueLastTextbook" hover-class="card-hover">
    <view class="last-hint-left">
      <view class="last-hint-label">上次听</view>
      <view class="last-hint-value">{{lastTextbookText}}</view>
    </view>
    <view class="last-hint-action">再听一遍 ›</view>
  </view>

  <!-- 复习与记录：列表行 -->
  <view class="section-label">复习与记录</view>
  <view class="list-wrap">
    <view class="list-row" bindtap="goWrongBook" hover-class="cell-hover">
      <view class="list-icon">📕</view>
      <view class="list-text">
        <view class="list-title">错题本</view>
        <view class="list-desc">复习易错单词</view>
      </view>
      <view class="list-arrow">›</view>
    </view>
    <view class="list-row" bindtap="goRecord" hover-class="cell-hover">
      <view class="list-icon">📋</view>
      <view class="list-text">
        <view class="list-title">听写记录</view>
        <view class="list-desc">历史练习</view>
      </view>
      <view class="list-arrow">›</view>
    </view>
  </view>

  <!-- 最近练过区域 -->
  <view class="recent-wrap">
    <view class="recent-header">
      <text class="recent-title">最近练过</text>
      <text class="recent-more" bindtap="goRecord">查看全部 ></text>
    </view>

    <view class="recent-card-wrap">
      <view wx:if="{{recentList.length > 0}}" class="recent-list">
        <view 
          class="recent-item"
          wx:for="{{recentList}}"
          wx:key="rId"
          data-rid="{{item.rId}}"
          bindtap="viewPractice"
          hover-class="cell-hover"
        >
          <view class="recent-inner-left">
            <view class="recent-time">{{item.timeDisplay}}</view>
            <view class="recent-desc">
              <text>听写单词 {{item.wordCount}} 个，错 </text>
              <text class="recent-err">{{item.errCount}}</text>
              <text> 个</text>
            </view>
          </view>
          <view class="recent-inner-right">></view>
        </view>
      </view>

      <view wx:else class="recent-empty">
        <text>还没有练习记录，快去开始听写吧</text>
      </view>
    </view>
  </view>

  <view class="feedback-wrap">
    <button open-type="feedback" class="feedback-btn">
      💬 意见反馈>
    </button>
  </view>

  <!-- 隐藏Canvas，用于相册图片裁剪为1.35比例 -->
  <canvas type="2d" id="preprocessCanvas" style="position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;"></canvas>
</view>
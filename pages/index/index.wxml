<view class="status-bar" style="height:{{statusBarHeight}}px; background-color: #f5faff;"></view>
<!-- 自定义导航栏 -->
<view class="custom-nav" style="padding-top:{{statusBarHeight}}px;">
  <view class="nav-title">英语听写帮手</view>
</view>

<view class="page" style="padding-top:{{navTotalHeight}}px">
  <view class="banner-card">
    <view class="banner-left">
      <view class="banner-title">英语听写不求人</view>
      <view class="banner-subtitle">同步1-9年级教材，选一课就能听写</view>
    </view>
    <view class="banner-illustration">
      <image src="/images/child.png" mode="aspectFit" style="width:100%;height:100%;"/>
    </view>
  </view>

  <!-- 核心功能区 -->
  <view class="func-wrap">

    <!-- 主大卡片：按教材听写（家长主路径） -->
    <view class="func-card main-card" bindtap="goBooks" hover-class="card-hover">
      <view class="main-icon"><text class="icon-emoji">📚</text></view>
      <view class="main-text">
        <view class="main-title">按教材听写单词</view>
        <view class="main-desc">同步课本字词表，按课文勾选听写</view>
      </view>
      <view class="arrow-btn"><text class="arrow">></text></view>
    </view>

    <!-- 通栏卡片：拍照听写 -->
    <view class="func-card full-card" bindtap="goPhotoDict" hover-class="card-hover">
      <view class="full-icon">📷</view>
      <view class="full-text">
        <view class="full-title">拍照听单词</view>
        <view class="full-desc">临时词表、拍一下就能听写</view>
      </view>
      <view class="arrow-btn"><text class="arrow">></text></view>
    </view>

    <!-- 两栏并排小卡片 -->
    <view class="func-row">
      <view class="func-card col-card" bindtap="goCustomDict" hover-class="card-hover">
        <view class="col-icon">✍️</view>
        <view class="col-text">
          <view class="col-title">批量录入单词</view>
          <view class="col-desc">输入或粘贴多个</view>
        </view>
        <view class="col-arrow">></view>
      </view>
      <!-- 上传照片 -->
      <view class="func-card col-card" bindtap="goUploadPhoto" hover-class="card-hover">
        <view class="col-icon">🖼️</view>
        <view class="col-text">
          <view class="col-title">传图识单词</view>
          <view class="col-desc">从相册选图</view>
        </view>
        <view class="col-arrow">></view>
      </view>
    </view>

    <!-- 错题本：通栏大卡片（无图标） -->
    <view class="func-card full-card small-card" bindtap="goWrongBook" hover-class="card-hover">
      <view class="full-text">
        <view class="full-title">错题本</view>
        <view class="full-desc">记录易错单词</view>
      </view>
      <view class="arrow-btn light-arrow"><text class="arrow">></text></view>
    </view>

    <!-- 通栏卡片：听写记录（无图标） -->
    <view class="func-card small-card" bindtap="goRecord" hover-class="card-hover">
      <view class="full-text">
        <view class="full-title">听写记录</view>
        <view class="full-desc">查看全部历史听写练习</view>
      </view>
      <view class="arrow-btn light-arrow"><text class="arrow">></text></view>
    </view>
  </view>

  <!-- 最近练过区域 -->
  <view class="recent-wrap">
    <view class="recent-header">
      <text class="recent-title">最近练过</text>
      <text class="recent-more" bindtap="goRecord">查看全部 ></text>
    </view>

    <view class="recent-card-wrap">
      <view wx:if="{{recentList.length > 0}}" class="recent-list">
        <view 
          class="recent-item"
          wx:for="{{recentList}}"
          wx:key="rId"
          data-rid="{{item.rId}}"
          bindtap="viewPractice"
          hover-class="cell-hover"
        >
          <view class="recent-inner-left">
            <view class="recent-time">{{item.timeDisplay}}</view>
            <view class="recent-desc">
              <text>听写单词 {{item.wordCount}} 个，错 </text>
              <text class="recent-err">{{item.errCount}}</text>
              <text> 个</text>
            </view>
          </view>
          <view class="recent-inner-right">></view>
        </view>
      </view>

      <view wx:else class="recent-empty">
        <text>还没有练习记录，快去开始听写吧</text>
      </view>
    </view>
  </view>

  <view class="feedback-wrap">
    <button open-type="feedback" class="feedback-btn">
      💬 意见反馈>
    </button>
  </view>

  <!-- 隐藏Canvas，用于相册图片裁剪为1.35比例 -->
  <canvas type="2d" id="preprocessCanvas" style="position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;"></canvas>
</view>
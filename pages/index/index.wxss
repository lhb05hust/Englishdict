page {
  background-color: #f5faff;
  padding: 32rpx 24rpx;
  margin: 0;
  box-sizing: border-box;
}
.status-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000; /* 比导航栏更高 */
  background-color: #f5faff; /* 和导航栏背景色一致 */
}

.custom-nav {
  position: fixed;
  z-index: 999;
  background-color: #f5faff;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding-bottom: 16rpx;
  width: 100%;
  isolation: isolate;
  transform: translateZ(0);
}
.nav-title {
  font-size: 36rpx;     /* 标题字号，觉得太大调40rpx，太小调44rpx */
  font-weight: 600;
  color: #222222;
}

/* 页面整体偏移，避开导航栏 */
.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
}


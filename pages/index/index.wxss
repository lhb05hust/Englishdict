page {
  background-color: #f5faff;
  padding: 32rpx 24rpx;
  margin: 0;
  box-sizing: border-box;
}
.status-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background-color: #f5faff;
}

.custom-nav {
  position: fixed;
  z-index: 999;
  background-color: #f5faff;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding-bottom: 16rpx;
  width: 100%;
  isolation: isolate;
  transform: translateZ(0);
}
.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
}

.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 功能卡片基础 ============ */
.func-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(96, 165, 250, 0.18);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* ============ 主卡：按教材听写 ============ */
.main-card {
  padding: 44rpx 36rpx;
  margin-bottom: 20rpx;
  min-height: 214rpx;
}
.main-icon {
  width: 96rpx;
  height: 96rpx;
  background: #e0f2fe;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}
.icon-emoji {
  font-size: 64rpx;
  transform: translateY(-6rpx);
}
.main-text {
  flex: 1;
}
.main-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}
.main-desc {
  font-size: 26rpx;
  color: #888;
}
.arrow-btn {
  width: 64rpx;
  height: 64rpx;
  background: #60a5fa;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 12rpx rgba(96, 165, 250, 0.43);
}
.arrow {
  transform: translateY(-4rpx);
}

/* ============ 拍照行：加宽主卡 + 右侧堆叠 ============ */
.photo-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* 左侧：拍照听写（flex 1.5，与主卡同高） */
.photo-card {
  flex: 1.5;
  flex-direction: row;
  padding: 28rpx 26rpx;
  min-height: 214rpx;
  width: 0;
  gap: 18rpx;
}

.photo-icon {
  width: 76rpx;
  height: 76rpx;
  background: #e0f2fe;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.photo-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.photo-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.2;
}

.photo-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.3;
}

.photo-arrow {
  font-size: 48rpx;
  color: #6185b1;
  flex-shrink: 0;
  line-height: 1;
}

/* 右侧：相册 + 粘贴 上下堆叠 */
.sub-col {
  flex: 1;
  width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sub-card {
  flex: 1;
  flex-direction: row;
  padding: 20rpx 22rpx;
  min-height: 80rpx;
  border-radius: 24rpx;
  gap: 10rpx;
}

.sub-icon {
  font-size: 30rpx;
  flex-shrink: 0;
  line-height: 1;
}

.sub-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.2;
}

.sub-arrow {
  font-size: 40rpx;
  color: #6185b1;
  flex-shrink: 0;
  line-height: 1;
}

/* ============ 上次听：轻提示卡 ============ */
.last-hint {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 3rpx 12rpx rgba(96, 165, 250, 0.10);
}
.last-hint-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.last-hint-label {
  font-size: 26rpx;
  color: #94a3b8;
}
.last-hint-value {
  font-size: 28rpx;
  color: #222222;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.last-hint-action {
  font-size: 26rpx;
  color: #1e3a8a;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* ============ 分组小标题 ============ */
.section-label {
  font-size: 30rpx;
  color: #666666;
  font-weight: 500;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  margin-left: 12rpx;
}

/* ============ 复习与记录：列表行 ============ */
.list-wrap {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(96, 165, 250, 0.18);
  margin-bottom: 40rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.list-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 2rpx solid #e6edf7;
}
.list-row:last-child {
  border-bottom: none;
}

.list-icon {
  width: 64rpx;
  height: 64rpx;
  background: #e6f0ff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.list-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.list-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
}

.list-desc {
  font-size: 26rpx;
  color: #888;
}

.list-arrow {
  font-size: 40rpx;
  color: #6185b1;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ============ 最近练过 ============ */
.recent-wrap {
  margin-top: 12rpx;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.recent-title {
  margin-left: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #666666;
}

.recent-more {
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #666666;
}

.recent-card-wrap {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 4rpx 8rpx 24rpx rgba(96, 165, 250, 0.25);
  padding: 0 32rpx;
  box-sizing: border-box;
}

.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e6edf7;
}
.recent-item:last-child {
  border-bottom: none;
}

.recent-inner-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recent-time {
  font-size: 28rpx;
  font-weight: 500;
  color: #444444;
}

.recent-desc {
  font-size: 26rpx;
  color: #444444;
}

.recent-err {
  font-size: 26rpx;
  color: #e53e3e;
}

.recent-inner-right {
  font-size: 28rpx;
  color: #dadada;
  flex-shrink: 0;
}

.recent-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #888888;
}

/* ============ 交互反馈 ============ */
.card-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

.cell-hover {
  background-color: #f7faff;
}

.feedback-wrap {
  margin-top: 60rpx;
  margin-bottom: 80rpx;
  display: flex;
  justify-content: center;
}
.feedback-btn {
  font-size: 27rpx;
  color: #888;
  background: none;
  border: none;
  padding: 24rpx 0;
}
.feedback-btn::after {
  border: none;
}
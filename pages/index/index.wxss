.banner-card {
  background: linear-gradient(135deg, #bfdbfe, #dbeafe );
  color: #3c618f;
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden; /* 防止插画溢出 */
  min-height: 160rpx; /* 给插画足够高度 */
}
/* .banner-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.95;
} */
.banner-left {
  position: relative;
  z-index: 2;
  flex: 1;
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.banner-subtitle {
  font-size: 28rpx;
  opacity: 0.95;
}

/* 插画容器 */
.banner-illustration {
  position: absolute;
  right: 6rpx;
  bottom: -4rpx;
  width: 170rpx;
  height: 170rpx;
  z-index: 1;
  pointer-events: none;
}

.banner-illustration svg {
  width: 100%;
  height: 100%;
  display: block;
}

.func-wrap {
  margin-bottom: 48rpx;
  box-sizing: border-box;
}
.func-card {
  background: #ffffff;
  border-radius: 24rpx;
  /* 增强凸起阴影，区分banner，可点击操作卡片 */
  box-shadow: 0 8rpx 24rpx rgba(96, 165, 250, 0.18);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.main-card {
  padding: 44rpx 36rpx;
  margin-bottom: 28rpx;
  min-height: 214rpx;
}
.main-icon {
  width: 96rpx;
  height: 96rpx;
  background: #e0f2fe;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
}
.icon-emoji {
  font-size: 64rpx;
  /* 只对emoji文字做偏移，背景盒子不动 */
  transform: translateY(-6rpx);
}
.main-text {
  flex: 1;
}
.main-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}
.main-desc {
  font-size: 26rpx;
  color: #888;
}
.arrow-btn {
  width: 64rpx;
  height: 64rpx;
  background: #60a5fa;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  /* 箭头圆形按钮增加凸起阴影，明亮悬浮效果 */
  box-shadow: 0 6rpx 12rpx rgba(96, 165, 250, 0.43);
}
.arrow {
  transform: translateY(-4rpx);
}

/* 次要入口箭头（弱化处理，降低视觉吸引力） */
.light-arrow {
  font-size: 26rpx;
  width: 56rpx;
  height: 56rpx;
  background: #f0f7ff; /* 浅淡的蓝色，和白色融合 */
  color: #93c5fd;      /* 淡蓝色箭头 */
  box-shadow: none;    /* 去除主按钮那种悬浮的重阴影 */
  transform: translateX(-6px);
}

.func-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.col-card {
  flex: 1;
  /* 改成横向flex，实现箭头垂直居中 */
  flex-direction: row;
  padding: 24rpx 20rpx;
  align-items: center !important;
  width: 0;
  min-height: 170rpx;
}
.col-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
  margin-bottom: 0;
  flex-shrink: 0;
}
.col-card:nth-child(1) .col-icon {
  background: #e6f0ff;
}
.col-card:nth-child(2) .col-icon {
  background: #dce9ff;
}
.col-text {
  width: auto;
  flex: 1;
  margin-bottom: 0rpx;
}
.col-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 6rpx;
}
.col-desc {
  font-size: 26rpx;
  color: #888;
}
.col-arrow {
  /* 直接flex布局天然垂直居中 */
  align-self: center;
  font-size: 28rpx;
  color: #6185b1;
  flex-shrink:0;
}

.full-card {
  padding: 32rpx 32rpx;
  min-height: 170rpx;
  margin-bottom: 28rpx;
}
.full-icon {
  width: 80rpx;
  height: 80rpx;
  background: #e0f2fe;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.full-text {
  flex: 1;
}
.full-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 6rpx;
}
.full-desc {
  font-size: 26rpx;
  color: #888;
}

.small-card {
  padding: 26rpx 28rpx;
  min-height: 120rpx;
  margin-bottom: 28rpx;
}

/* ========== 最近练过 标题在外，列表装进白色圆角卡片 ========== */
.recent-wrap {
  margin-top: 12rpx;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.recent-title {
  margin-left: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.recent-more {
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #666666;
}

/* 外层卡片：和func‑card视觉统一，白色、圆角、阴影 */
.recent-card-wrap {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 4rpx 8rpx 24rpx rgba(96, 165, 250, 0.25);
  padding: 0 32rpx;
  box-sizing: border-box;
}

.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #e6edf7;
}
/* 最后一条条目去掉底部分割线 */
.recent-item:last-child {
  border-bottom: none;
}

.recent-inner-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recent-time {
  font-size: 30rpx;
  font-weight: 500;
  color: #444444;
}

.recent-desc {
  font-size: 26rpx;
  color: #444444;
}

.recent-err {
  font-size: 26rpx;
  color: #e53e3e;
}

.recent-inner-right {
  font-size: 28rpx;
  color: #dadada;
  flex-shrink: 0;
}

.recent-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #888888;
}

/* 卡片点击按压效果 */
.card-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

.cell-hover {
  background-color: #f7faff;
}

.feedback-wrap {
  margin-top: 60rpx;
  margin-bottom: 80rpx;
  display:flex;
  justify-content:center;
}
.feedback-btn {
  font-size:27rpx;
  color:#888;
  background:none;
  border:none;
  padding:24rpx 0;
}
.feedback-btn::after {
  border: none;
}

page {
  background-color: #f0f4f8;
  min-height: 100%;
}

.container {
  padding: 32rpx;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

/* 底部留白占位，撑出可滚动区域，避免被 fixed footer 遮挡 */
.footer-spacer {
  height: calc(240rpx + env(safe-area-inset-bottom));
  width: 100%;
}

/* 头部样式 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #222222;
  flex-shrink: 0;
}

.count {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
}

/* 提示行样式 */
.tips-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  gap: 20rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 1;
}

/* 网格布局核心 */
.grid-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.grid-item {
  transition: all 0.25s ease;
}

.grid-item.dragging {
  opacity: 0;
  transform: scale(0.95);
}

/* 卡片容器，统一圆角+统一阴影，加最小高度保证同行对齐 */
.card-wrapper {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 3rpx 14rpx rgba(96, 165, 250, 0.08);
  overflow: hidden;
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
}

/* 拖拽图标缩小，减少与英文单词冲突 */
.movable-handle {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 10;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0f2fe;
  border-radius: 50%;
  margin: 10rpx;
}

.drag-icon {
  font-size: 26rpx;
  color: #60a5fa;
  line-height: 1;
}

/* 卡片内容 */
.card {
  padding: 10rpx 20rpx 20rpx 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 0;
}

/* card-top 右侧给拖拽图标留位置，防止长单词被盖住 */
.card-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
  margin-left: 4rpx;
  padding-right: 68rpx;
  min-height: 0;
}

.index-num {
  font-size: 26rpx;
  color: #888888;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

/* 英文单词：字号略小、允许换行、最多 2 行，避免撑破卡片 */
.word-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #222222;
  flex: 1;
  min-width: 0;
  line-height: 1.25;
  word-break: break-word;
  overflow-wrap: anywhere;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.word-text:active {
  opacity: 0.65;
}

/* 中文释义区 */
.cn-row {
  margin: 0 4rpx 16rpx 4rpx;
  padding-top: 4rpx;
  min-height: 34rpx;
}
.cn-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.35;
  word-break: break-word;
  overflow-wrap: anywhere;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.cn-text:active {
  opacity: 0.65;
}

/* 删除按钮 */
.delete-btn {
  width: 50%;
  height: 42rpx;
  text-align: center;
  line-height: 42rpx;
  font-size: 24rpx;
  background-color: #faebeb;
  color: #b56d6d;
  border-radius: 30rpx;
  padding: 0;
  margin: 0;
  border: none;
  box-sizing: border-box;
}

.delete-btn::after {
  border: none;
}

/* 新增卡片样式：和普通卡片保持同样最小高度 */
.add-card {
  background-color: #ffffff;
  border: 2rpx dashed #c5d8f0;
  border-radius: 24rpx;
  justify-content: center;
  align-items: center;
  box-shadow: none;
  min-height: 240rpx;
  box-sizing: border-box;
}
.plus-icon {
  font-size: 80rpx;
  color: #4d9af8;
  margin-right: 12rpx;
  line-height: 1;
  font-weight: 300;
  transform: translateY(-2rpx);
}

.add-placeholder {
  font-size: 28rpx;
  color: #666666;
}

/* 幽灵卡片 */
.ghost-card {
  position: fixed;
  z-index: 999;
  pointer-events: none;
}
.ghost-card .card-wrapper {
  box-shadow: 0 16rpx 48rpx rgba(96, 165, 250, 0.22);
  transform: scale(1.06);
}
.ghost-card .index-num {
  color: #60a5fa;
}

/* 底部固定按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
  box-shadow: none;
  border-top: none;
  box-sizing: border-box;
  z-index: 99;
}

.footer::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: env(safe-area-inset-bottom);
  background: #f7f9fc;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  border-top: 2rpx solid #e8edf3;
  box-shadow: 0 -3rpx 14rpx rgba(96, 165, 250, 0.06);
  z-index: 1;
}

.footer::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: env(safe-area-inset-bottom);
  background: rgba(247, 249, 252, 0.9);
  z-index: 1;
}

.confirm-btn {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 0;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #dbeafe;
  color: #444444;
  font-size: 36rpx;
  border-radius: 50rpx;
  font-weight: bold;
  box-sizing: border-box;
}

.confirm-btn::after {
  border: none;
}
.btn-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

/* 听写规则模块 */
.section {
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 24rpx 32rpx;
  box-shadow: 0 3rpx 14rpx rgba(96, 165, 250, 0.08);
  width: 100%;
  box-sizing: border-box;
}

/* 强制 van-cell-group 撑满 section，避免被内部边距挤窄 */
.section van-cell-group {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222222;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
}

.setting-cell {
  padding: 28rpx 16rpx !important;
}
.setting-cell::after {
  left: 16rpx !important;
  right: 16rpx !important;
  border-color: #e4edf8 !important;
}
.last-cell::after {
  display: none !important;
}
.hide-default-title {
  flex: 1 !important;
}

.setting-block {
  display: flex;
  flex-direction: column;
  width: 100%;
}
.setting-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
}
.options-row {
  display: flex;
  gap: 16rpx;
}
.option-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #e0f2fe;
  color: #555555;
  font-size: 30rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}
.option-btn.active {
  background: #bfdbfe;
  color: #222222;
  font-weight: 500;
}

.custom-input-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.custom-input {
  width: 160rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f0f7ff;
  border: 2rpx solid #bfdbfe;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #222222;
}
.custom-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 12rpx;
}

.take-count-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 8rpx;
}
.take-count-num {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1rpx;
  color: #222222;
  text-align: center;
  border-radius: 16rpx;
}

.slider-wrapper {
  margin-top: 24rpx;
  padding: 0 6rpx;
}
.slider-wrapper slider {
  margin: 0 !important;
  padding: 0 !important;
}
.wx-slider-handle {
  background-color: #bfdbfe !important;
  border-color: #222222 !important;
}
.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* ============ 智能批量添加弹窗 ============ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  width: 100%;
  max-width: 660rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.modal-header {
  position: relative;
  text-align: center;
  margin-bottom: 24rpx;
  height: 60rpx;
  line-height: 60rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
}

.modal-clear-btn {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #033c81;
  padding: 6rpx 22rpx;
  background: #e0f2fe;
  border-radius: 24rpx;
  line-height: 1.4;
}

.modal-paste-btn {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #033c81;
  padding: 6rpx 22rpx;
  background: #e0f2fe;
  border-radius: 24rpx;
  line-height: 1.4;
}

.modal-textarea {
  width: 100%;
  height: 260rpx;
  background: #f0f7ff;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #222222;
  line-height: 1.55;
}
.modal-placeholder {
  color: #94a3b8;
  font-size: 28rpx;
  line-height: 1.55;
}

.char-counter-row {
  text-align: right;
  margin-top: 8rpx;
  padding-right: 8rpx;
}
.char-counter {
  font-size: 24rpx;
  color: #94a3b8;
  transition: color 0.2s ease;
}
.char-counter-warn {
  color: #e53e3e;
  font-weight: 500;
}

.modal-preview {
  margin-top: 20rpx;
  min-height: 70rpx;
}
.preview-label {
  font-size: 28rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 12rpx;
}
.preview-label-active {
  color: #1e3a8a;
  font-weight: 500;
}
.preview-label-error {
  color: #e53e3e;
  font-weight: 500;
}
.preview-scroll {
  max-height: 220rpx;
}
.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-bottom: 4rpx;
}
.preview-tag {
  padding: 8rpx 22rpx;
  background: #e0f2fe;
  color: #1e3a8a;
  font-size: 28rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.modal-btn-cancel {
  background: #f0f7ff;
  color: #555555;
}
.modal-btn-confirm {
  background: #bfdbfe;
  color: #1e3a8a;
  font-weight: 600;
}
.modal-btn-disabled {
  background: #e5e7eb;
  color: #9ca3af;
}
page {
  background-color: #f0f4f8;
  min-height: 100%;
}

.container {
  padding: 32rpx;
  padding-bottom: 32rpx;
  box-sizing: border-box;
}

/* ============ 顶部 ============ */
.header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #222222;
}

.switch-btn {
  font-size: 28rpx;
  color: #1e3a8a;
  background: #e0f2fe;
  padding: 16rpx 36rpx;
  border-radius: 28rpx;
  line-height: 1.2;
}

/* ============ 空提示 ============ */
.empty-tip {
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
  padding: 200rpx 0;
}

/* ============ 单元卡片 ============ */
.lesson-block {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 3rpx 14rpx rgba(96, 165, 250, 0.08);
}

/* 单元头：整块可点，激活态浅蓝高亮 */
.lesson-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 16rpx;
  border-radius: 16rpx;
  background: #f0f7ff;
  transition: background-color 0.12s ease;
}

.lesson-header-active {
  background: #e0f2fe;
}

/* 按下即高亮，反馈明显 */
.lesson-header-hover {
  background: #d4e8fc;
}

.lesson-title-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.lesson-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}

.lesson-count {
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

/* ============ checkbox（扩大热区 + 视觉放大）============ */
/* 外层 hit 容器：把热区从 52rpx 扩到 100rpx，视觉不变 */
.checkbox-hit {
  padding: 24rpx;
  margin: -24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  border: 3rpx solid #c5d8f0;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.12s ease;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #60a5fa;
  border-color: #60a5fa;
}

.check-icon {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 1;
}

/* ============ 单词 chips ============ */
.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #ffffff;
  border: 2rpx solid #e4edf8;
  border-radius: 12rpx;
  min-width: 76rpx;
  max-width: 100%;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.chip-active {
  background: #e0f2fe;
  border-color: #60a5fa;
}

.chip-text {
  font-size: 30rpx;
  color: #222222;
  font-weight: 500;
  line-height: 1.25;
  text-align: center;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.chip-pinyin {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  line-height: 1.3;
  text-align: center;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.chip-active .chip-pinyin {
  color: #1e3a8a;
}

/* ============ 底部固定 ============ */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
  box-shadow: none;
  border-top: none;
  box-sizing: border-box;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: env(safe-area-inset-bottom);
  background: #f7f9fc;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  border-top: 2rpx solid #e8edf3;
  box-shadow: 0 -3rpx 14rpx rgba(96, 165, 250, 0.06);
  z-index: 1;
}

.footer::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: env(safe-area-inset-bottom);
  background: rgba(247, 249, 252, 0.9);
  z-index: 1;
}

.footer-left {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 180rpx;
}

.footer-count {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.2;
}

.clear-btn {
  font-size: 28rpx;
  color: #1e3a8a;
  background: #e0f2fe;
  padding: 8rpx 24rpx;
  border-radius: 22rpx;
  line-height: 1.2;
  transition: all 0.2s ease;
}

.clear-btn-disabled {
  background: #f0f4f8;
  color: #c5c9d0;
}

.confirm-btn {
  position: relative;
  z-index: 2;
  padding: 0 120rpx;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #dbeafe;
  color: #444444;
  font-size: 35rpx;
  border-radius: 45rpx;
  font-weight: bold;
  transition: all 0.2s ease;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn.disabled {
  background-color: #e5e7eb;
  color: #9ca3af;
}

.btn-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

.table-header-hover {
  opacity: 0.7;
}

/* ============================================================
   教材选择弹窗
   ============================================================ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(240, 244, 248, 0.94);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  width: 100%;
  max-width: 660rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
  box-shadow: 0 16rpx 48rpx rgba(96, 165, 250, 0.18);
}

.modal-header {
  position: relative;
  text-align: center;
  margin-bottom: 24rpx;
  height: 60rpx;
  line-height: 60rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
}

.book-body {
  padding: 4rpx 4rpx 0;
}

.group-label {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.group-label-term {
  margin-top: 28rpx;
}

.grade-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx 24rpx;
  margin-bottom: 8rpx;
}

.grade-btn {
  justify-self: center;
  width: 180rpx;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  background: #e0f2fe;
  color: #555555;
  font-size: 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #93c5fd;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.grade-btn.active {
  background: #bfdbfe;
  color: #1e3a8a;
  font-weight: 600;
  border-color: #60a5fa;
}

.term-row {
  display: flex;
  gap: 32rpx;
  justify-content: center;
}

.term-btn {
  width: 240rpx;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  background: #e0f2fe;
  color: #555555;
  font-size: 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #93c5fd;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.term-btn.active {
  background: #bfdbfe;
  color: #1e3a8a;
  font-weight: 600;
  border-color: #60a5fa;
}

.ver-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx 24rpx;
}

.ver-btn {
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  background: #e0f2fe;
  color: #555555;
  font-size: 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #93c5fd;
  transition: all 0.2s ease;
  box-sizing: border-box;
  padding: 0 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ver-btn.active {
  background: #bfdbfe;
  color: #1e3a8a;
  font-weight: 600;
  border-color: #60a5fa;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.modal-btn-confirm {
  margin-top: 50rpx;
  background: #bfdbfe;
  color: #1e3a8a;
  font-weight: 600;
}

.modal-btn-cancel {
  background: #f0f7ff;
  color: #555555;
}

.footer-spacer {
  height: calc(200rpx + env(safe-area-inset-bottom));
  width: 100%;
}
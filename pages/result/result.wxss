page {
  background: #f0f4f8;
  height: 100%;
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f0f4f8;
  padding: 32rpx;
}

/* 头部样式 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
  flex-shrink: 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #222222;
}

.count {
  font-size: 26rpx;
  color: #666666;
}

/* 提示行样式 */
.tips-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 27rpx;
  color: #666666;
}

/* 滚动区域 */
.grid-list {
  flex: 1;
  width: 100%;
}

.empty-tip {
  text-align: center;
  padding-top: 100rpx;
  color: #888888;
}

/* Grid布局：英文单词较长，使用 2 列 */
.grid-container {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  width: 100%;
  padding-bottom: 230rpx;
}

.grid-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx 20rpx;
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 130rpx;
  box-sizing: border-box;
}

.word {
  font-size: 34rpx;
  font-weight: bold;
  color: #222222;
  margin-top: 4rpx;
  text-align: center;
  line-height: 1.3;
  word-break: break-word;
}

.tone {
  font-size: 26rpx;
  color: #666666;
  margin-top: 6rpx;
  text-align: center;
  word-break: break-word;
}
.errText {
  color: rgb(245, 6, 18);
}

.item-actions {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 14rpx;
}

.action-btn {
  padding: 0;
  border-radius: 10rpx;
  border: none;
  font-size: 26rpx;
  font-weight: normal !important;
  color: #222222;
  text-align: center;
  width: 100rpx !important;
  height: 46rpx;
  line-height: 46rpx;
  background: #e2f4e9;
  box-shadow: none;
  margin: 0;
}

.action-btn.unMarkErr {
  background: #f8b0a8;
}

.action-btn:active {
  opacity: 0.7;
}

/* 底部固定按钮 */
.footer {
  position: fixed;
  bottom: 0rpx;
  left: 0;
  width: 100%;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
  box-shadow: none;
  border-top: none;
  box-sizing: border-box;
  z-index: 99;
  display: flex;
  gap: 24rpx;
}

.footer::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: env(safe-area-inset-bottom);
  background: #f7f9fc;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  border-top: 2rpx solid #e8edf3;
  box-shadow: 0 -3rpx 14rpx rgba(96, 165, 250, 0.06);
  z-index: 1;
}

.footer::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: env(safe-area-inset-bottom);
  background: rgba(247, 249, 252, 0.8);
  z-index: 1;
}

.confirm-btn {
  position: relative;
  z-index: 2;
  flex: 1;
  padding: 0;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn.primary {
  background-color: #dbeafe;
  color: #444444;
  font-size: 36rpx;
}

.confirm-btn.secondary {
  background-color: #e8edf3;
  color: #666666;
  font-size: 34rpx;
}

.confirm-btn::after {
  border: none;
}

.btn-hover {
  opacity: 0.82;
  transform: scale(0.98);
}
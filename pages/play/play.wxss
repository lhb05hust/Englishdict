page {
  background-color: #f0f4f8;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 260rpx;
  box-sizing: border-box;
}

.btn-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

/* ========== 顶部进度区 ========== */
.progress-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}
.progress-track {
  width: 100%;
  height: 8rpx;
  background: #e0f2fe;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.progress-fill {
  height: 100%;
  background: #93b4e0; /* 柔和一点的蓝 */
  border-radius: 4rpx;
  transition: width 0.35s ease, background-color 0.2s ease;
}
.progress-fill.is-paused {
  background: #cbd5e1; /* 暂停变灰一点 */
}
.progress-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.main-index {
  font-size: 52rpx;
  font-weight: bold;
  color: #222222;
}
.sub-status {
  font-size: 32rpx;
  color: #555555;
  transition: color 0.2s ease;
}
.sub-status.is-paused {
  color: #1e3a8a;
  font-weight: 500;
}

/* ========== 核心卡片（回归第一版浅蓝） ========== */
.word-card {
  flex: 1;
  min-height: 400rpx;
  background: #dbeafe; /* 第一版的底色 */
  border: none;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  position: relative;
  transition: all 0.2s ease;
}
/* 播放中的轻微呼吸感 */
.word-card.is-speaking {
  animation: breathe 2s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { box-shadow: 0 0 0 rgba(96, 165, 250, 0); }
  50%      { box-shadow: 0 0 30rpx rgba(96, 165, 250, 0.2); }
}
.word-card.is-paused {
  animation-play-state: paused;
  background: #e2e8f0; /* 暂停时退去蓝色 */
}

/* 卡片文字 */
.word-hide {
  font-size: 40rpx;
  color: #5579aa;
}
.word-en {
  font-size: 64rpx;
  font-weight: 600;
  color: #1e3a8a;
  text-align: center;
  line-height: 1.3;
  word-break: break-word;
  overflow-wrap: anywhere;
  margin-bottom: 20rpx;
}
.word-cn {
  font-size: 34rpx;
  color: #5579aa;
  text-align: center;
  line-height: 1.5;
}

/* ========== 辅助操作：圆润药丸形 ========== */
.aux-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}
.aux-btn {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 45rpx; /* 完美药丸 */
  font-size: 30rpx;
  color: #555555;
  transition: all 0.15s;
}
.aux-btn.aux-active {
  background: #dbeafe;
  color: #1e3a8a;
  font-weight: 500;
}

/* ========== 主操作区 ========== */
.main-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}
.ctrl {
  display: flex;
  align-items: center;
  justify-content: center;
}
.ctrl-side {
  flex: 1;
  height: 110rpx;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 55rpx; /* 大药丸 */
  color: #333333;
}
.ctrl-text {
  font-size: 32rpx;
  font-weight: 500;
}

/* 主按钮大圆 */
.ctrl-center {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #dbeafe;
  flex-shrink: 0;
  transition: background-color 0.2s ease;
}
.ctrl-center.is-paused {
  background: #bfdbfe;
}

/* 暂停/播放图标 */
.pause-icon {
  display: flex;
  gap: 10rpx;
}
.pause-icon::before,
.pause-icon::after {
  content: '';
  width: 12rpx;
  height: 40rpx;
  background: #1e3a8a;
  border-radius: 3rpx;
}
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 20rpx 0 20rpx 30rpx;
  border-color: transparent transparent transparent #1e3a8a;
  margin-left: 8rpx;
}

/* ========== 底部 ========== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f0f4f8;
  border-top: 2rpx solid #e0eaf8;
  box-sizing: border-box;
}
.footer-hint {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 20rpx;
}
.footer-btns {
  display: flex;
  gap: 24rpx;
}
.footer-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 48rpx; /* 药丸 */
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  box-sizing: border-box;
}
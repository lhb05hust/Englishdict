page {
  background-color: #f0f4f8;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  /* 底部的 260rpx 增加到 320rpx，强行把卡片( flex:1 ) 压短 5% */
  padding: 40rpx 32rpx 320rpx; 
  box-sizing: border-box;
}

.btn-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

/* ========== 顶部进度区：紧凑靠拢 ========== */
.progress-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx; /* 从 40rpx 缩小 */
  flex-shrink: 0;
}
.progress-track {
  width: 100%;
  height: 8rpx;
  background: #e0f2fe;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx; /* 从 24rpx 缩小 */
}
.progress-fill {
  height: 100%;
  background: #93b4e0;
  border-radius: 4rpx;
  transition: width 0.35s ease, background-color 0.2s ease;
}
.progress-fill.is-paused {
  background: #cbd5e1;
}
.progress-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx; /* 从 12rpx 大幅缩小，让两行字紧贴 */
}

.main-index {
  font-size: 52rpx;
  font-weight: bold;
  color: #222222;
}

.sub-status {
  font-size: 32rpx;
  color: #555555;
  transition: color 0.2s ease;
}

.sub-status.is-paused {
  color: #1e3a8a;
  font-weight: 500;
}

/* ========== 核心卡片 ========== */
.word-card {
  flex: 1;
  min-height: 360rpx; /* 稍微降低最小高度 */
  background: #dbeafe;
  border: none;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  position: relative;
  transition: all 0.2s ease;
}
.word-card.is-speaking {
  animation: breathe 2s ease-in-out infinite;
}
@keyframes breathe {
  0%, 100% { box-shadow: 0 0 0 rgba(96, 165, 250, 0); }
  50%      { box-shadow: 0 0 30rpx rgba(96, 165, 250, 0.2); }
}
.word-card.is-paused {
  animation-play-state: paused;
  background: #e2e8f0;
}

/* --- 卡片文字：动态字号 --- */
.word-hide {
  font-size: 44rpx;
  color: #5579aa;
}
.word-en {
  font-weight: 600;
  color: #1e3a8a;
  text-align: center;
  line-height: 1.2;
  word-break: break-word;
  overflow-wrap: anywhere;
  margin-bottom: 24rpx;
  transition: font-size 0.2s;
}
.word-en.font-xxl { font-size: 96rpx; }
.word-en.font-lg  { font-size: 76rpx; }
.word-en.font-xl  { font-size: 56rpx; }

.word-cn {
  color: #5579aa;
  text-align: center;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: anywhere;
  transition: font-size 0.2s;
}
.word-cn.font-md { font-size: 40rpx; }
.word-cn.font-sm { font-size: 32rpx; }

/* ========== 辅助操作 ========== */
.aux-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx; /* 从 40rpx 减小，往上提一点 */
  flex-shrink: 0;
}
.aux-btn {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 45rpx;
  font-size: 30rpx;
  color: #555555;
  transition: all 0.15s;
}
.aux-btn.aux-active {
  background: #dbeafe;
  color: #1e3a8a;
  font-weight: 500;
}

/* ========== 主操作区 ========== */
.main-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 0; /* 干掉底部边距，因为给 page padding-bottom 留了巨大空间 */
  flex-shrink: 0;
}
.ctrl {
  display: flex;
  align-items: center;
  justify-content: center;
}
.ctrl-side {
  flex: 1;
  height: 110rpx;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 55rpx;
  color: #333333;
}
.ctrl-text {
  font-size: 32rpx;
  font-weight: 500;
}

.ctrl-center {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: #dbeafe;
  flex-shrink: 0;
  transition: background-color 0.2s ease;
}
.ctrl-center.is-paused {
  background: #bfdbfe;
}

.pause-icon {
  display: flex;
  gap: 10rpx;
}
.pause-icon::before,
.pause-icon::after {
  content: '';
  width: 12rpx;
  height: 40rpx;
  background: #1e3a8a;
  border-radius: 3rpx;
}
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 20rpx 0 20rpx 30rpx;
  border-color: transparent transparent transparent #1e3a8a;
  margin-left: 8rpx;
}

/* ========== 底部固定区域 ========== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  /* padding-top 从 16 大幅增加到 40rpx，让 footer 顶部产生巨大的呼吸留白 */
  padding: 40rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f0f4f8;
  border-top: 2rpx solid #e0eaf8;
  box-sizing: border-box;
  z-index: 99;
}
.footer-hint {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 20rpx;
}
.footer-btns {
  display: flex;
  gap: 24rpx;
}
.footer-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  box-sizing: border-box;
}
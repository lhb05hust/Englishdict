page {
  background-color: #f5faff;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx 320rpx;
  box-sizing: border-box;
}

.btn-hover {
  opacity: 0.82;
  transform: scale(0.98);
}

/* ========== 顶部进度区：对齐全站浅蓝主题 ========== */
.progress-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
  flex-shrink: 0;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: #e0f2fe;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: #60a5fa;
  border-radius: 6rpx;
  transition: width 0.35s ease, background-color 0.2s ease;
}

.progress-fill.is-paused {
  background: #cbd5e1;
}

.progress-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.main-index {
  font-size: 52rpx;
  font-weight: bold;
  color: #222222;
}

.sub-status {
  font-size: 32rpx;
  color: #555555;
  transition: color 0.2s ease;
}

.sub-status.is-paused {
  color: #1e3a8a;
  font-weight: 500;
}

/* ============================================================ */
/* 中间卡片：严格保持第一版视觉，不再参与主题色调整               */
/* ============================================================ */
.word-card {
  flex: 1;
  min-height: 360rpx;
  background: #dbeafe;
  border: none;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  position: relative;
  transition: all 0.2s ease;
}

.word-card.is-speaking {
  animation: breathe 2s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { box-shadow: 0 0 0 rgba(96, 165, 250, 0); }
  50%      { box-shadow: 0 0 30rpx rgba(96, 165, 250, 0.2); }
}

.word-card.is-paused {
  animation-play-state: paused;
  background: #e2e8f0;
}

.word-hide {
  font-size: 44rpx;
  color: #5579aa;
}

.word-en {
  font-weight: 600;
  color: #1e3a8a;
  text-align: center;
  line-height: 1.2;
  word-break: break-word;
  overflow-wrap: anywhere;
  margin-bottom: 24rpx;
  transition: font-size 0.2s;
}

.word-en.font-xxl { font-size: 96rpx; }
.word-en.font-lg  { font-size: 76rpx; }
.word-en.font-xl  { font-size: 56rpx; }

.word-cn {
  color: #5579aa;
  text-align: center;
  line-height: 1.5;
  word-break: break-word;
  overflow-wrap: anywhere;
  transition: font-size 0.2s;
}

.word-cn.font-md { font-size: 40rpx; }
.word-cn.font-sm { font-size: 32rpx; }
/* ============================================================ */

/* ========== 辅助操作区：保持原来的浅色点击感 ========== */
.aux-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
  flex-shrink: 0;
}

.aux-btn {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 45rpx;
  font-size: 30rpx;
  color: #555555;
  transition: all 0.15s;
}

/* 激活态保持第一版的浅蓝高亮，不再用深色 */
.aux-btn.aux-active {
  background: #dbeafe;
  color: #1e3a8a;
  font-weight: 500;
  border-color: #dbeafe;
}

.aux-btn.aux-added {
  background: #ecfdf5;
  color: #059669;
  border-color: #a7f3d0;
}

/* ========== 主操作区：圆形播放按钮和进度条统一变淡 ========== */
.main-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 0;
  flex-shrink: 0;
}

.ctrl {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ctrl-side {
  width: 180rpx;
  height: 84rpx;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 42rpx;
  color: #666666;
}

.ctrl-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 中间圆形按钮：比上一版更深一点，但仍属于浅蓝体系 */
/* 中间圆形按钮：保持加深后的颜色 */
.ctrl-center {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: #93c5fd;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
}

.ctrl-center.is-paused {
  background: #60a5fa;
}

/* 暂停图标：补全容器尺寸，确保两条竖线稳定渲染 */
.pause-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 60rpx;
  height: 50rpx;
}

.pause-icon::before,
.pause-icon::after {
  content: '';
  width: 14rpx;
  height: 46rpx;
  background: #1e3a8a;
  border-radius: 4rpx;
  display: block;
}

/* 播放箭头：保持不变 */
.play-icon {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 22rpx 0 22rpx 34rpx;
  border-color: transparent transparent transparent #1e3a8a;
  margin-left: 6rpx;
}


/* ========== 底部固定区域：对齐浅蓝主题 ========== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5faff 70%, rgba(245, 250, 255, 0));
  box-sizing: border-box;
  z-index: 99;
}

.footer-hint {
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 16rpx;
}

.footer-btns {
  display: flex;
  gap: 24rpx;
}

.footer-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #dbeafe;
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  box-sizing: border-box;
}

.footer-btn.danger-btn {
  background: #f1f5f9;
  color: #64748b;
  border-color: #e2e8f0;
}

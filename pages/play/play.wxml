<wxs module="utils">
  var getEnClass = function(text) {
    if (!text) return 'font-lg';
    if (text.length >= 12) return 'font-xl';
    if (text.length >= 6) return 'font-lg';
    return 'font-xxl';
  };
  var getCnClass = function(text) {
    if (!text) return 'font-md';
    return text.length >= 16 ? 'font-sm' : 'font-md';
  };
  module.exports = {
      getEnClass: getEnClass,
      getCnClass: getCnClass
  };
</wxs>

<view class="page">
  <!-- 顶部进度区 -->
  <view class="progress-header">
    <view class="progress-track">
      <view class="progress-fill {{playStatus === 'paused' ? 'is-paused' : ''}}"
            style="width: {{(currentWordIndex + 1) / totalCount * 100}}%"></view>
    </view>
    <view class="progress-meta">
      <text class="main-index">第 {{currentWordIndex + 1}} / {{totalCount}} 个</text>
      <text class="sub-status {{playStatus === 'paused' ? 'is-paused' : ''}}">{{playStatus === 'paused' ? '已暂停' : (subStatusText || '准备中')}}</text>
    </view>
  </view>

  <!-- 中间卡片：严格保持第一版样式，不再参与主题色调整 -->
  <view class="word-card {{playStatus === 'paused' ? 'is-paused' : (subStatus === 1 ? 'is-speaking' : '')}}"
        bindtap="replayCurrent"
        bindtouchstart="onCardTouchStart"
        bindtouchend="onCardTouchEnd">
    <block wx:if="{{!showWord && !showCn}}">
      <text class="word-hide">单词已隐藏</text>
    </block>
    <block wx:else>
      <text wx:if="{{showWord}}" class="word-en {{utils.getEnClass(currentWord.text)}}">{{currentWord.text}}</text>
      <text wx:if="{{showCn}}" class="word-cn {{utils.getCnClass(currentWord.cn)}}">{{currentWord.cn || '暂无释义'}}</text>
    </block>
  </view>

  <!-- 辅助操作区 -->
  <view class="aux-row">
    <view class="aux-btn {{showCn ? 'aux-active' : ''}}" bindtap="toggleShowCn" hover-class="btn-hover">
      <text>看释义</text>
    </view>
    <view class="aux-btn {{showWord ? 'aux-active' : ''}}" bindtap="toggleShowWord" hover-class="btn-hover">
      <text>{{showWord ? '隐藏' : '看单词'}}</text>
    </view>
    <view class="aux-btn {{isAddedErr ? 'aux-added' : ''}}" bindtap="add2ErrBook" hover-class="btn-hover">
      <text>{{isAddedErr ? '✓ 已加入' : '加错题'}}</text>
    </view>
  </view>

  <!-- 主操作区 -->
  <view class="main-controls">
    <view class="ctrl ctrl-side" bindtap="prevWord" hover-class="btn-hover">
      <text class="ctrl-text">‹ 上一个</text>
    </view>
    <view class="ctrl ctrl-center {{playStatus === 'paused' ? 'is-paused' : ''}}"
          bindtap="togglePause" hover-class="btn-hover">
      <view class="pause-icon" wx:if="{{playStatus !== 'paused'}}"></view>
      <view class="play-icon" wx:else></view>
    </view>
    <view class="ctrl ctrl-side" bindtap="nextWord" hover-class="btn-hover">
      <text class="ctrl-text">下一个 ›</text>
    </view>
  </view>

  <!-- 底部退出区 -->
  <view class="footer">
    <view class="footer-hint">没听到声音？请关闭静音模式或调高音量</view>
    <view class="footer-btns">
      <view class="footer-btn" bindtap="editCurrentWord" hover-class="btn-hover">改单词</view>
      <view class="footer-btn danger-btn" bindtap="confirmFinish" hover-class="btn-hover">结束听写</view>
    </view>
  </view>
</view>

page {
  height: 100vh;
  background: #0a0a0a;
}

.container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-bottom: 60rpx;
  margin-top: 60rpx;
}

.camera-wrapper {
  background: #000;
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.camera-view {
  width: 100%;
  height: 100%;
  display: block;
}

/* 中间拍照大圆按钮，蓝色渐变外环 */
.shoot-inner {
  margin-top: 36rpx;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: #ffffff;
  /* 多层蓝色环形光晕 */
  box-shadow: 0 0 0 12rpx rgba(111, 170, 241, 0.3),
              0 0 0 22rpx rgba(191, 219, 254, 0.12);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.shoot-inner:active {
  transform: scale(0.82);
  box-shadow: 0 0 0 6rpx rgba(111, 170, 241, 0.3),
              0 0 0 14rpx rgba(191, 219, 254, 0.08);
}

/* 底部操作栏间距完全不变 */
.action-bar {
  margin-top: 10rpx;
  width: 86%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 左右功能按钮 恢复深色半透样式 */
.action-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(60, 60, 60, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.22s ease;
}
.action-btn:active {
  background: rgba(138, 135, 135, 0.9);
  transform: scale(0.86);
}
.action-btn .icon {
  font-size: 42rpx;
  color: #ccc;
  font-weight: 200;
  line-height: 1;
}
.close-btn .icon {
  font-size: 50rpx;
  color: rgb(180, 206, 245);
}
.flip-btn .icon {
  font-size: 84rpx;
  margin-bottom: 16rpx;
  margin-left: 14rpx;
  color: rgb(180, 206, 245);
  transition: transform 0.6s cubic-bezier(0.68, -0.55, 0.27, 1.55);
  display: inline-block;
}
.flip-btn.flip .icon {
  transform: rotateY(180deg);
}

/* ===== 非全面屏适配（iPhone 7 Plus 等） ===== */
.not-full-screen .shoot-inner {
  margin-top: 0rpx;
}
.not-full-screen .action-bar {
  margin-top: 50rpx;
  margin-bottom: 56rpx;
}


